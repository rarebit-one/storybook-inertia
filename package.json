{
  "name": "@rarebit-one/storybook-inertia",
  "version": "0.1.0",
  "description": "Storybook mock of @inertiajs/react — render Inertia page components without a backend.",
  "license": "MIT",
  "author": "rarebit-one",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rarebit-one/storybook-inertia.git"
  },
  "homepage": "https://github.com/rarebit-one/storybook-inertia#readme",
  "bugs": {
    "url": "https://github.com/rarebit-one/storybook-inertia/issues"
  },
  "keywords": [
    "storybook",
    "inertia",
    "inertiajs",
    "react",
    "mock",
    "testing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm run verify:dts",
    "verify:dts": "node scripts/verify-dts.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  }
}
